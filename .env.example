# Copy to .env and fill in BOTH secrets below. Never commit .env.
# They are intentionally empty: docker compose refuses to start until they are set.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Must be URL-safe ([A-Za-z0-9_-] only): it is embedded in DATABASE_URL, so characters
# such as @ : / # % ? break the connection string. token_urlsafe output is fine.
POSTGRES_PASSWORD=
# Optional: enables LLM explanations; leave empty to disable.
OPENAI_API_KEY=
# Host port for the web tier (8000 is deliberately not used).
WEB_PORT=8080
ACCESS_TOKEN_MINUTES=60
