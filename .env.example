# Copy to .env and replace the placeholders. Never commit .env.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-to-a-strong-password
# Optional: enables LLM explanations; leave empty to disable.
OPENAI_API_KEY=
# Host port for the web tier (8000 is deliberately not used).
WEB_PORT=8080
ACCESS_TOKEN_MINUTES=60
